# ── Database ──────────────────────────────────────────────────────────
# PostgreSQL thật:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wms_core?schema=public"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wms_shadow?schema=public"

# Hoặc dùng server Postgres cục bộ của Prisma (không cần cài PostgreSQL):
#   npx prisma dev --name wms -d      # in ra connection string dạng postgres://...
# rồi dán vào DATABASE_URL ở trên (nhớ giữ tham số ?schema=).

# Số connection tối đa của pool. Server dev của Prisma (PGlite) chỉ phục vụ một
# phiên tại một thời điểm nên phải đặt bằng 1; PostgreSQL thật để trống (mặc định 10).
# DATABASE_POOL_MAX=1
